{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@smzcoder/server": ["packages/server/src/index.ts"],
      "@smzcoder/server/*": ["packages/server/src/*"],
      "@smzcoder/shared": ["packages/shared/src/index.ts"],
      "@smzcoder/shared/*": ["packages/shared/src/*"],
        "@smzcoder/database": ["packages/database/src/index.ts"],
        "@smzcoder/database/*": ["packages/database/src/*"],
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  }
}
